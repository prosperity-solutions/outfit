# The edges of the profile's own files below a replaced directory: what is in the way is never
# replaced, the team starting to track a path turns it into a swap, a lost record leaves nothing
# behind, and a directory where the team keeps a .gitignore gets no extras.
fixture repo team upstream
cd repo
exec mkdir -p skills
exec sh -c 'echo team-a > skills/a.md; echo team-z > skills/z.md'
exec git add skills
exec git commit -qm 'docs: team skills'
exec git push -q origin HEAD:main
exec mkdir -p .outfit/profiles/mine/skills/deep
exec sh -c 'printf "[outfit \"profile\"]\n    replace = skills\n" > .outfit/profiles/mine/profile.config'
exec sh -c 'echo my-a > .outfit/profiles/mine/skills/a.md; echo my-new > .outfit/profiles/mine/skills/new.md; echo my-later > .outfit/profiles/mine/skills/later.md; echo my-deep > .outfit/profiles/mine/skills/deep/x.md'
exec git add --sparse -f .outfit
exec git commit -qm 'feat: a profile that replaces skills and adds files'
outfit init

# a regular file already standing at an extra's path is never replaced: a copy is saved
exec sh -c 'echo user-owns-this > skills/new.md'
! outfit use mine
stderr 'skills/new.md is a regular file'
exec cat skills/new.md
stdout 'user-owns-this'
exec cat skills/later.md
stdout 'my-later'
exec cat skills/.gitignore
! stdout 'new.md'
exec rm skills/new.md
outfit sync
exec sh -c 'test -L skills/new.md'

# the team starts to track skills/later.md: the link stays, as a swap now
cd ../
exec git clone -q repo-upstream.git other
cd other
exec git config user.email a@b
exec git config user.name a
exec sh -c 'echo team-later > skills/later.md'
exec git add skills/later.md
exec git commit -qm 'docs: the team adds later.md'
exec git push -q origin HEAD:main
cd ../repo
exec git pull -q --rebase origin main
outfit sync
exec sh -c 'test -L skills/later.md'
exec cat skills/later.md
stdout 'my-later'
outfit status --json
stdout '"path": *"skills/later.md"'
exec cat skills/.gitignore
! stdout 'later'

# the record is a cache: lose it, and a sync (or uninstall) still finds our links
exec sh -c 'rm .git/outfit/state.json'
outfit use base
! exists skills/new.md
! exists skills/deep
! exists skills/.gitignore
