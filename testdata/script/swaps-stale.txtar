# docs/HANDOVER.md §3.5 "stale base" (scenario 4): a clean pull that changes a base
# file under a swap keeps the swap and the variant untouched; sync says so on one
# line and exits 0, status flags it and exits 4, `outfit diff` shows what changed
# upstream, `outfit ack` accepts it.
fixture repo team upstream
cd repo
outfit init
outfit use yolo
islink AGENTS.md .outfit/profiles/yolo/AGENTS.md
exec cat .outfit/profiles/yolo/AGENTS.md
cp stdout $WORK/variant-before.txt

# Upstream changes the BASE AGENTS.md and one more file.
cd ..
exec git clone -q repo-upstream.git other
cd other
exec git config user.email a@b
exec git config user.name a
exec sh -c 'echo "new base rule" >> AGENTS.md'
exec git commit -aqm 'docs: base rule'
exec git push -q origin HEAD:main
cd ../repo

# The pull is clean; its post-merge sync says it on one line and exits 0.
exec git pull -q --ff-only origin main
stderr 'AGENTS.md: the base file changed upstream'
! stderr 'Traceback'
islink AGENTS.md .outfit/profiles/yolo/AGENTS.md
exec cat .outfit/profiles/yolo/AGENTS.md
cmp stdout $WORK/variant-before.txt
outfit sync
stderr 'the base file changed upstream'
outfit sync --json
stdout '"stale":\["AGENTS.md"\]'
stdout '"in_sync":true'   # nothing left for sync to do: stale is its own field
stdout '"needs_human":false'

# status flags it (exit 4) without touching anything.
! outfit status
stdout 'state    stale'
! outfit status --json
stdout '"stale":\["AGENTS.md"\]'

# diff shows what changed upstream; --json carries it.
outfit diff AGENTS.md
stdout '\+new base rule'
stdout 'outfit ack AGENTS.md'
outfit diff AGENTS.md --json
stdout '"stale":true'
stdout 'new base rule'
# from a subdirectory the path is relative to where you are
cd apps/web
! outfit diff nope.md
stderr 'not swapped by outfit'
cd ../..

# a path that is not swapped has no base to compare
! outfit ack README.md
stderr 'is not swapped by outfit'
stderr 'fix: outfit status'

# ack accepts it: the note is gone, the variant was never touched.
outfit ack AGENTS.md
stdout 'new base is recorded'
outfit sync
! stderr .
outfit status
stdout 'state    in sync'
outfit diff AGENTS.md
stdout 'nothing to look at'
outfit ack AGENTS.md
stdout 'nothing to acknowledge'
exec cat .outfit/profiles/yolo/AGENTS.md
cmp stdout $WORK/variant-before.txt

# A later sync never re-stales an acknowledged base, and switching away and back
# records the new base as the starting point.
outfit use base
exec cat AGENTS.md
stdout 'new base rule'
outfit use yolo
outfit status
stdout 'state    in sync'

# One upstream commit that changes the base AND the profile's own file is the
# maintainer adapting the profile to the new base: nothing is stale, and an edit to
# the base alone afterwards still is.
cd ../other
exec git pull -q origin main
exec sh -c 'echo "base v3" >> AGENTS.md; echo "yolo v3" >> .outfit/profiles/yolo/AGENTS.md'
exec git commit -aqm 'docs: adapt the profile to the new base'
exec git push -q origin HEAD:main
cd ../repo
exec git pull -q --ff-only origin main
! stderr 'changed upstream'
outfit status
stdout 'state    in sync'
exec cat .outfit/profiles/yolo/AGENTS.md
stdout 'yolo v3'
cd ../other
exec sh -c 'echo "base v4" >> AGENTS.md'
exec git commit -aqm 'docs: base only'
exec git push -q origin HEAD:main
cd ../repo
exec git pull -q --ff-only origin main
stderr 'AGENTS.md: the base file changed upstream'
outfit ack AGENTS.md

# A damaged state.json cannot make `outfit diff` pass anything but an object id to git.
exec sh -c 'sed -i.bak "s/\"base_blob\": \"[0-9a-f]*\"/\"base_blob\": \"--output=pwned\"/" .git/outfit/state.json'
! outfit diff AGENTS.md
stderr 'not a git object id'
! exists pwned
exec sh -c 'rm -f .git/outfit/state.json.bak .git/outfit/state.json'
outfit sync
