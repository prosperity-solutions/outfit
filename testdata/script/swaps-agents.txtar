# `outfit init --agents` (docs/HANDOVER.md §3.5 triggers, §4): a Claude Code
# SessionStart entry that runs `outfit sync`, added only where a .claude directory
# exists, to the PERSONAL settings.local.json, leaving every other setting alone, and
# taken away by uninstall.
fixture repo team worktrees=1
cd repo

# Without --agents nothing is written, .claude or not.
exec mkdir .claude
outfit init
! exists .claude/settings.local.json

# --dry-run says what it would do and writes nothing.
outfit init --agents --dry-run
stdout 'would add'
! exists .claude/settings.local.json

# With --agents: the entry, once, in the worktree that has .claude (the linked one
# has none: it is skipped, not an error).
outfit init --agents
stdout 'SessionStart entry added in 1 worktree'
exists .claude/settings.local.json
grep '"SessionStart"' .claude/settings.local.json
grep '# outfit-managed' .claude/settings.local.json
grep ' sync' .claude/settings.local.json
! exists ../repo-wt1/.claude
# status says so (and --json too); without the entry it says nothing.
outfit status
stdout 'agents   Claude Code SessionStart entry installed'
outfit status --json
stdout '"agents_session_start":true'
# Twice changes nothing.
exec cp .claude/settings.local.json $WORK/settings.once
outfit init --agents
! stdout 'added'
cmp .claude/settings.local.json $WORK/settings.once
outfit init --agents --json
stdout '"agents":\{"added":\[\],'

# The session-start command is silent and works: it runs sync (a missing link is
# back) without printing anything.
outfit use yolo
exec rm AGENTS.md
exec sh -c 'cmd=$(sed -n "s/.*\"command\": \"\(.*\)\",*$/\1/p" .claude/settings.local.json); sh -c "$cmd"'
! stdout .
! stderr .
islink AGENTS.md .outfit/profiles/yolo/AGENTS.md

# A hook of the person's own inside outfit's item survives both.
cp $WORK/shared.json .claude/settings.local.json
outfit init --agents
grep 'echo mine' .claude/settings.local.json
grep '# outfit-managed' .claude/settings.local.json
outfit uninstall
grep 'echo mine' .claude/settings.local.json
! grep 'outfit-managed' .claude/settings.local.json

# Other settings and hooks survive an update and an uninstall.
cp $WORK/mine.json .claude/settings.local.json
outfit init --agents
grep 'Bash\(go test' .claude/settings.local.json
grep 'echo mine' .claude/settings.local.json
grep '# outfit-managed' .claude/settings.local.json
outfit uninstall
grep 'echo mine' .claude/settings.local.json
grep 'Bash\(go test' .claude/settings.local.json
! grep 'outfit-managed' .claude/settings.local.json

# The entry stays out of `git add -A` (info/exclude, removed again by uninstall).
rm .claude/settings.local.json
outfit init --agents
exec git status --short
! stdout 'claude'
exec git add -A
exec git status --short
! stdout 'claude'
exec cat .git/info/exclude
stdout 'settings.local.json'
outfit uninstall
! grep 'settings.local.json' .git/info/exclude

# Running init --agents again repairs a missing ignore line (an interrupted run, a
# branch that lacks it); uninstall keeps the line while an entry is still there.
rm .claude/settings.local.json
outfit init --agents
exec sh -c 'grep -v "settings.local.json\|init --agents" .git/info/exclude > $WORK/exclude.new; cp $WORK/exclude.new .git/info/exclude'
! grep 'settings.local.json' .git/info/exclude
outfit init --agents
grep 'settings.local.json' .git/info/exclude
exec sh -c 'echo "// a comment" >> .claude/settings.local.json'
! outfit uninstall
stderr 'could not undo'
grep 'settings.local.json' .git/info/exclude
exec sh -c 'grep -v "^//" .claude/settings.local.json > $WORK/fixed.json; cp $WORK/fixed.json .claude/settings.local.json'
outfit uninstall
! grep 'settings.local.json' .git/info/exclude

# A settings file outfit made is removed with its entry.
rm .claude/settings.local.json
outfit init --agents
exists .claude/settings.local.json
outfit uninstall
! exists .claude/settings.local.json
exists .claude

# A settings file outfit cannot read is left exactly as it is, with a message.
# (the exit is 3: the dispatcher is in, but the entry you asked for was not written)
cp $WORK/bad.json .claude/settings.local.json
! outfit init --agents
stderr 'could not add the SessionStart entry'
cmp .claude/settings.local.json $WORK/bad.json
! outfit init --agents --json
stdout '"errors":\["'
# ...and uninstall is not stopped by a file outfit never wrote.
outfit uninstall
cmp .claude/settings.local.json $WORK/bad.json
# A repository that COMMITS the file makes it everyone's: outfit does not edit it.
rm .claude/settings.local.json
exec sh -c 'echo "{}" > .claude/settings.local.json'
exec git add -f .claude/settings.local.json
exec git commit -qm 'chore: shared claude settings'
! outfit init --agents
stderr 'is tracked by git'
exec cat .claude/settings.local.json
stdout '^\{\}$'
exec git status --short
! stdout .

# A settings file that is a link is not followed, and uninstall does not follow it.
exec git rm -q -f .claude/settings.local.json
exec sh -c 'echo "{\"env\":{\"TOKEN\":\"secret\"}}" > $WORK/elsewhere.json'
exec mkdir -p .claude
symlink .claude/settings.local.json -> $WORK/elsewhere.json
! outfit init --agents
stderr 'not a plain file'
exec cat $WORK/elsewhere.json
stdout 'secret'
islink .claude/settings.local.json $WORK/elsewhere.json
outfit uninstall
exec cat $WORK/elsewhere.json
stdout 'secret'
# A worktree added LATER (coding agents isolate their work in new worktrees) gets the
# entry too, when the main worktree has it and the new one has a .claude directory.
rm .claude/settings.local.json
exec sh -c 'echo x > .claude/keep.md && git add -f .claude/keep.md && git commit -qm "chore: claude dir"'
outfit init
outfit init --agents
grep 'outfit-managed' .claude/settings.local.json
exec git worktree add -q ../repo-later
exists ../repo-later/.claude/settings.local.json
grep 'outfit-managed' ../repo-later/.claude/settings.local.json
-- mine.json --
{"permissions":{"allow":["Bash(go test:*)"]},"hooks":{"SessionStart":[{"hooks":[{"type":"command","command":"echo mine"}]}]}}
-- shared.json --
{"hooks":{"SessionStart":[{"hooks":[{"type":"command","command":"echo mine"},{"type":"command","command":"old # outfit-managed"}]}]}}
-- bad.json --
{ // not json
}
